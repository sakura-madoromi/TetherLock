// ===================================================================
// 智能玩具电子锁盒 - 完整三维装配总成 (Master CAD Assembly)
// 集成：主箱体、顶盖、易损锁舌、舵机凸轮、MG90S、ESP32-C3、18650、OLED、免螺丝压板
// ===================================================================

$fn = 40;

// --- 动画与交互仿真参数 ---
lid_angle   = 0;   // 顶盖开合角度 (0° = 闭锁, 15° = 弹开, 90° = 垂直, 110° = 仰靠)
servo_angle = 0;   // 舵机解锁角度 (0° = 锁定插销, 60° = 完全退回开锁)
exploded    = 0;   // 爆炸图视图 (0 = 正常装配, 1 = 分离爆炸)

// --- 引用零部件模块 ---
use <base_box.scad>
use <top_lid.scad>
use <breakaway_latch.scad>
use <servo_cam.scad>
use <servo_clamp.scad>
use <components/mg90s_servo.scad>
use <components/esp32_c3.scad>
use <components/battery_18650.scad>
use <components/oled_096.scad>

// ===================================================================
// 1. 底盒结构基体 (Base Box)
// ===================================================================
color([0.22, 0.28, 0.36, 0.95]) // 深灰蓝磨砂质感
    base_box();

// ===================================================================
// 2. 电气仓内部硬件与免螺丝固定系统 (Electronics Bay Components)
// ===================================================================

// A. MG90S 舵机 (安装于 X=95.0, Y=20.0 舵机槽内，输出轴位于 X=95.0, Y=20.0)
translate([95.0 + 5.9, 20.0, 2.4 + 1.0]) {
    // 舵机本体
    mg90s_servo();
}

// B. M2 双内六角螺栓与六角防转螺母紧固五金 (M2 Hex Socket Screws & Nuts)
// 左螺钉与螺母 (X=86.9, Y=20.0), 右螺钉与螺母 (X=114.9, Y=20.0)
for (hx = [86.9, 114.9]) {
    // M2 内六角圆柱头螺栓 (从上往下压紧舵机耳)
    color([0.8, 0.85, 0.9]) {
        translate([hx, 20.0, 2.4 + 1.0 + 17.5 + 2.5 + (exploded ? 25 : 0)]) {
            // 螺钉头
            cylinder(d=3.8, h=2.0);
            // 螺杆向下穿透
            translate([0, 0, -11.0])
                cylinder(d=2.0, h=11.0);
        }
    }
    // M2 六角防转螺母 (嵌入底座侧向沉槽 Z=13.5~15.5)
    color([0.9, 0.8, 0.3]) {
        translate([hx, 20.0 + (exploded ? 20 : 0), 13.5 + 0.2]) {
            cylinder(r=4.0/sqrt(3), h=1.6, $fn=6);
        }
    }
}

// C. 舵机黄铜锁舌凸轮摆臂 (Servo Cam Horn, 安装在舵机输出轴顶端)
// 轴心精确位于 (X=95.0, Y=20.0, Z=32.5)
translate([95.0, 20.0, 2.4 + 1.0 + 28.5 + 1.0]) {
    rotate([0, 0, servo_angle]) {
        // 舵机摆臂 (默认 0° 朝向 -X 锁死锁舌，旋转 +60° 脱开)
        servo_cam();
    }
}

// D. ESP32-C3 SuperMini 核心主控板
// 坐落于前仓专属托架上，Type-C 端口朝向 +X 对齐外壳右壁
translate([106.0, 43.0, 12.0]) {
    rotate([0, 0, 0])
        esp32_c3();
}

// E. 18650 锂电池电芯
// 卧式横卧在后仓全尺寸卡爪座内 (Y in [-56, +10.5], X=100.0)
translate([100.0, -56.0, 2.4 + 9.8]) {
    rotate([-90, 0, 0])
        battery_18650();
}

// F. 0.96" OLED 显示屏
// 垂直贴合在右侧视窗内壁 (玻璃表面对齐内壁 X=117.6, Y=22.0, Z=32.5)
translate([117.6, 22.0, 32.5]) {
    oled_096();
}

// ===================================================================
// 3. 顶盖、燕尾滑槽与易损锁舌联动总成 (Top Lid & Latch Assembly)
// ===================================================================
// 铰链旋转轴心：Y = -63.5, Z = 55.0
hinge_py = -63.5;
hinge_pz = 55.0;

translate([0, hinge_py, hinge_pz + (exploded ? 40 : 0)]) {
    rotate([lid_angle, 0, 0]) {
        translate([0, -hinge_py, -hinge_pz]) {
            // A. 顶盖主结构 (底面精准对齐 Z=55.0 分型面)
            translate([0, 0, 55.0]) {
                color([0.88, 0.92, 0.96, 0.85]) // 浅色半透明防护顶盖
                    top_lid();
            }

            // B. 易损断裂卡扣 (Breakaway Latch)
            // 严丝合缝滑入顶盖燕尾槽 (X=81.0, Y=10.0, Z=50.5, 雄榫嵌入雌榫)
            translate([81.0, 10.0, 50.5]) {
                color([0.98, 0.42, 0.12]) // 醒目橙色易损指示色
                    breakaway_latch();
            }
        }
    }
}

// ===================================================================
// 4. 后置铰链不锈钢销轴 (Hinge Pin)
// ===================================================================
color([0.8, 0.8, 0.85]) {
    translate([-90, hinge_py, hinge_pz])
        rotate([0, 90, 0])
        cylinder(d=2.0, h=180);
}
