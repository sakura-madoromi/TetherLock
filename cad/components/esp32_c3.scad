// ===================================================================
// ESP32-C3 SuperMini 极小核心开发板
// 工业标准 1:1 CAD 实体模型
// ===================================================================

$fn = 30;

module esp32_c3() {
    // 1. 经典紫色/深黑 PCB 基板 (22.5 x 18.0 x 1.2 mm)
    color([0.15, 0.12, 0.25]) {
        translate([-22.5/2, -18.0/2, 0])
            cube([22.5, 18.0, 1.2]);
    }

    // 2. 金属屏蔽罩 (RF Shield Can: 12.0 x 10.0 x 1.8 mm)
    color([0.75, 0.75, 0.8]) {
        translate([-22.5/2 + 3.0, -5.0, 1.2])
            cube([12.0, 10.0, 1.8]);
    }

    // 3. 板载板载高频陶瓷/PCB 天线区 (金色条纹)
    color([0.8, 0.65, 0.2]) {
        translate([-22.5/2 + 0.5, -7.0, 1.2])
            cube([2.0, 14.0, 0.5]);
    }

    // 4. Type-C 母座接口 (位于一侧边缘，9.0 x 7.5 x 3.2 mm，凸出板边约 1.2mm)
    color([0.85, 0.85, 0.9]) {
        translate([22.5/2 - 6.5, -4.5, 1.2])
            cube([7.5, 9.0, 3.2]);
    }

    // 5. 镀金排针焊盘 (两排 8-pin 2.54mm 间距焊盘)
    color([0.9, 0.75, 0.2]) {
        for (i = [0 : 7]) {
            // 下排焊盘
            translate([-22.5/2 + 2.5 + i * 2.54, -18.0/2 + 1.2, 0.5])
                cylinder(d=1.0, h=1.5);
            // 上排焊盘
            translate([-22.5/2 + 2.5 + i * 2.54, 18.0/2 - 1.2, 0.5])
                cylinder(d=1.0, h=1.5);
        }
    }
}

esp32_c3();
