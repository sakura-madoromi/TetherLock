// ===================================================================
// 0.96" SSD1306 I2C 128x64 OLED 屏幕显示模块
// 工业标准 1:1 CAD 实体模型
// ===================================================================

$fn = 30;

module oled_096() {
    // 1. 蓝色 PCB 基板 (厚度沿 X: -3.0 到 -1.4, 宽 Y: 27.0, 高 Z: 27.0 mm)
    color([0.1, 0.35, 0.75]) {
        translate([-3.0, -27.0/2, -27.0/2])
            cube([1.6, 27.0, 27.0]);
    }

    // 2. 超薄玻璃显示面板 (厚度沿 X: -1.4 到 0.0, 宽 Y: 26.0, 高 Z: 15.0 mm)
    color([0.05, 0.08, 0.12]) {
        translate([-1.4, -26.0/2, -27.0/2 + 2.5])
            cube([1.4, 26.0, 15.0]);
    }

    // 3. 有效发光显示区 (X=0.01 贴面发光, 宽 Y: 21.7, 高 Z: 10.8 mm)
    color([0.2, 0.75, 0.95]) {
        translate([0.01, -21.7/2, -27.0/2 + 4.5])
            cube([0.05, 21.7, 10.8]);
    }

    // 4. 顶部 4-Pin 2.54mm I2C 排针 (VCC, GND, SCL, SDA, 朝向内部 -X 走线)
    color([0.2, 0.2, 0.2]) {
        translate([-5.5, -2.54*1.5 - 1.25, 27.0/2 - 3.5])
            cube([2.5, 2.54*3 + 2.5, 2.5]);
    }
    color([0.85, 0.75, 0.3]) {
        for (i = [0 : 3]) {
            translate([-5.5, -2.54*1.5 + i*2.54, 27.0/2 - 2.25])
                rotate([0, -90, 0])
                cylinder(d=0.6, h=6.0);
        }
    }
}

oled_096();
