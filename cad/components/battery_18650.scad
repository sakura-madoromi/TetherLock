// ===================================================================
// 标准 18650 锂离子电芯 (18650 Li-ion Cell)
// 工业标准 1:1 CAD 实体模型
// ===================================================================

$fn = 50;

module battery_18650() {
    // 直径 Ø18.4mm，长度 65.0mm (平头) ~ 66.5mm (凸头带保护板)
    // 经典青蓝色绝缘热缩套管 (Cyan/Green PVC Wrap)
    color([0.1, 0.65, 0.65]) {
        // 主圆柱体 (长 63.5mm)
        translate([0, 0, 1.0])
            cylinder(d=18.4, h=63.5);
        // 底部负极绝缘倒角环
        translate([0, 0, 0])
            cylinder(d1=17.0, d2=18.4, h=1.0);
    }

    // 负极平底金属垫片 (镀镍钢片)
    color([0.85, 0.85, 0.88]) {
        translate([0, 0, -0.2])
            cylinder(d=12.0, h=0.3);
    }

    // 正极凸头垫片 (Button Top with vent rim)
    color([0.9, 0.9, 0.92]) {
        // 阶梯台阶
        translate([0, 0, 64.5])
            cylinder(d=10.0, h=0.8);
        // 正极触点凸帽
        translate([0, 0, 65.3])
            cylinder(d=5.5, h=1.2);
    }
}

// 水平卧式放置方便装配预览
rotate([0, 90, 0])
    battery_18650();
