// ===================================================================
// MG90S 舵机免螺丝滑入式自锁压板 (Slide-in Retention C-Clamp)
// 100% 纯 3D 打印机械互锁结构，免螺栓螺母，徒手推入锁死
// ===================================================================

$fn = 30;

module servo_clamp() {
    // 整体尺寸: 38.0mm (长) x 14.0mm (宽) x 3.5mm (厚)
    // 两端带 45° 燕尾滑动倒角滑条，中间留出舵机主体阶梯避让通孔
    color([0.95, 0.45, 0.15]) { // 醒目橙色工程塑料
        difference() {
            // 1. 压板主横梁 (厚 3.5mm)
            translate([-37.0/2, -13.0/2, 0])
                cube([37.0, 13.0, 3.2]);
            
            // 2. 中间齿轮塔避让方孔 (长 23.4mm, 宽 12.6mm)
            // 仅两端各留出 6.8mm 实心板材紧紧压住舵机固定耳 (Ears)
            translate([-23.4/2, -14.0/2, -1])
                cube([23.4, 14.0, 6]);

            // 3. 两端滑轨外倒角 (斜向 45° 导轨咬合面)
            translate([-37.0/2, -13.0/2 - 0.1, 1.8])
                rotate([45, 0, 0])
                cube([37.0, 5, 5]);
            translate([-37.0/2, 13.0/2 + 0.1, 1.8])
                rotate([-45, 0, 0])
                cube([37.0, 5, 5]);
        }

        // 4. 末端阻尼防滑推出手柄 (Push/Pull Tab)
        translate([37.0/2 - 2.5, -5.0, 3.2])
            cube([2.5, 10.0, 2.5]);
    }
}

servo_clamp();
